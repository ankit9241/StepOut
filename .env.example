# ==============================================================================
# StepOut Environment Variables Reference
# All variables are optional with safe, deterministic defaults.
# The application will start cleanly and operate in built-in mode with no variables set.
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# AI Provider Configuration
# Set AI_PROVIDER to "ollama", "openai", or "none" (default: "none")
# ------------------------------------------------------------------------------
AI_PROVIDER=none
# AI_API_URL: e.g. "http://localhost:11434" (Ollama) or "https://api.openai.com/v1" (OpenAI-compatible)
AI_API_URL=
# AI_MODEL: e.g. "gemma:2b", "gemma2:2b", "gpt-4o-mini"
AI_MODEL=gemma:2b
# AI_API_KEY: Secret API key for hosted providers (server-side only, never exposed to client)
AI_API_KEY=
# AI_TIMEOUT_MS: Total request timeout for external AI provider calls (default: 20000 ms)
AI_TIMEOUT_MS=20000
# AI_MAX_CONCURRENCY: Maximum concurrent AI requests processed by the server (default: 3)
AI_MAX_CONCURRENCY=3

# ------------------------------------------------------------------------------
# Rate Limiting Configuration
# Configurable window and maximum request counts per IP
# ------------------------------------------------------------------------------
RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=100
RATE_LIMIT_CHALLENGES_MAX=15
RATE_LIMIT_REFLECTIONS_MAX=15

# ------------------------------------------------------------------------------
# Database Configuration (Optional Persistence)
# StepOut client maintains session state in localStorage.
# If MONGODB_URI is provided, challenge generations and reflections are also logged.
# ------------------------------------------------------------------------------
MONGODB_URI=
MONGODB_DB_NAME=stepout

# ------------------------------------------------------------------------------
# Security and Networking
# ------------------------------------------------------------------------------
# ALLOWED_ORIGINS: Comma-separated list of extra allowed CORS origins (leave empty for same-origin)
ALLOWED_ORIGINS=
# TRUST_PROXY: Set to "true" when running behind reverse proxies like Render (default: true)
TRUST_PROXY=true

# ------------------------------------------------------------------------------
# Development-only Client Setting
# Leave UNSET in production so the client makes same-origin requests to the unified service.
# ------------------------------------------------------------------------------
# VITE_API_URL=
